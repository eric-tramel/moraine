<clickhouse>
  <profiles>
    <default>
      <use_concurrency_control>1</use_concurrency_control>
      <max_memory_usage>__MAX_QUERY_MEMORY_BYTES__</max_memory_usage>
      <max_memory_usage_for_user>__MAX_USER_QUERY_MEMORY_BYTES__</max_memory_usage_for_user>
      <max_bytes_before_external_group_by>__DEFAULT_SPILL_BYTES__</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>__DEFAULT_SPILL_BYTES__</max_bytes_before_external_sort>
      <max_bytes_ratio_before_external_group_by>0</max_bytes_ratio_before_external_group_by>
      <max_bytes_ratio_before_external_sort>0</max_bytes_ratio_before_external_sort>
      <max_temporary_data_on_disk_size_for_query>2147483648</max_temporary_data_on_disk_size_for_query>
      <max_temporary_data_on_disk_size_for_user>4294967296</max_temporary_data_on_disk_size_for_user>
      <load_balancing>random</load_balancing>
    </default>
  </profiles>

  <users>
    <default>
      <password></password>
      <profile>default</profile>
      <quota>default</quota>
      <networks>
        <ip>127.0.0.1</ip>
        <ip>::1</ip>
      </networks>
      <access_management>1</access_management>
    </default>
  </users>

  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
